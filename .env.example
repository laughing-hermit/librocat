# librocat environment (copy per app as needed).

# --- Dashboard + remote MCP (apps/web/.env.local, written by `pnpm exec convex dev`) ---
# CONVEX_DEPLOYMENT=dev:<name>                  # your dev deployment, written by `pnpm exec convex dev`
# NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud   # on Vercel, `convex deploy --cmd` sets it from CONVEX_DEPLOY_KEY
# LIBROCAT_COMING_SOON=1                       # Vercel project env before launch: landing only, no sign-up (src/lib/coming-soon.ts)
# NEXT_PUBLIC_CONVEX_SITE_URL=https://<deployment>.convex.site   # optional: where Better Auth answers; unset, derived from NEXT_PUBLIC_CONVEX_URL
# NEXT_PUBLIC_LIBROCAT_MCP_URL=https://librocat.com/mcp   # optional override of the advertised URL
# LIBROCAT_SELF_HOST=1                         # self-hosting: hides Billing and plan limits (set on Convex too)
# OPENAI_APPS_CHALLENGE=<token>                # librocat Cloud: the domain token ChatGPT's plugin directory asks for (/.well-known/openai-apps-challenge)

# --- Convex deployment env (set with `pnpm exec convex env set`, not here) ---
# SITE_URL=http://localhost:3000       # the site's origin: Better Auth's base URL, the OAuth issuer
#                                      # (SITE_URL/api/auth), the MCP resource (SITE_URL/mcp), Stripe redirects
# BETTER_AUTH_SECRET=<random, 32+ bytes>   # signs sessions and encrypts the signing keys (convex/auth.ts)
# AUTH_RESEND_KEY=re_...               # sign-up and password-reset codes (convex/email.ts)
# AUTH_DEV_LOG_CODES=1                 # dev only, no Resend key: codes go to the Convex log instead
# LIBROCAT_E2E=1                       # dev only: dev:issueTestAccessToken / dev:createPasswordUser for the e2e suites
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_INDIVIDUAL=price_...        # Individual, $12 monthly
# STRIPE_PRICE_ID_TEAM=price_...              # Team, $15 per seat monthly
# STRIPE_PRICE_ID_INDIVIDUAL_ANNUAL=price_... # Individual, $120 yearly ($10/mo)
# STRIPE_PRICE_ID_TEAM_ANNUAL=price_...       # Team, $150 per seat yearly ($12.50/mo)
# STRIPE_PRICE_ID_INDEXATION=price_... # metered $0.01-a-credit price (Libro's credits, pay-as-you-go) on the meter below
# STRIPE_METER_INDEXATION=librocat_indexation
# STRIPE_MANAGED_PAYMENTS=1 # sell through Stripe's Managed Payments (Link, merchant of record)
# AI_GATEWAY_API_KEY=<Vercel AI Gateway key>   # Jev, the one model (cataloging, Libro's screens)
# AI_GATEWAY_API_KEY_FREE=<a key with its own budget>   # optional: Free libraries' calls, capped apart
# TYPESAFE_API_KEY=<key>                      # optional: Jev from TypeSafe directly, instead of the gateway
# LIBROCAT_JEV_URL=http://systemone:8000/v1   # optional: your own System One server (SELF_HOSTING.md)
# LIBROCAT_JEV_KEY=<key>                      # its key, if it needs one
# LIBROCAT_JEV=gateway                        # local, gateway, typesafe, or off; unset: the one that has settings
# LIBROCAT_AI_GATEWAY_URL=<base url>/v1       # optional: the gateway's base URL (the tests point it at a fake)
# LIBROCAT_EVAL_MODEL=typesafe-ai/jev          # typed judgments, every plan
# LIBROCAT_SELF_HOST=1                         # self-hosting: no plans, no quotas, no billing (convex/model.ts)
# LIBROCAT_FETCH_PRIVATE=1                     # self-hosting: the reading list and source watch may fetch pages on your own network
# LIBROCAT_FUNNEL_EMAIL=you@example.com        # the weekly funnel email's recipients, comma-separated; unset, none is sent (convex/funnel.ts)
