# Node / Next / Turborepo
node_modules/
.next/
dist/
.turbo/
.vercel/

# Convex local state
.convex/

# The browser suite's output (apps/web/e2e.config.ts). Its steps are exact,
# so it records no replays; any in .e2e/cache would be kept.
apps/web/.e2e/*
!apps/web/.e2e/cache/

# Env / secrets
.env
.env.local
apps/web/.env*

# Generated by `next dev` (generate-agent-files)
apps/web/AGENTS.md
apps/web/CLAUDE.md

# OS
.DS_Store

# Local Claude Code permissions (per machine)
.claude/settings.local.json

# Next / TypeScript build artifacts
apps/web/next-env.d.ts
*.tsbuildinfo

# Dev-only agent skills (shadcn), restored from skills-lock.json; kept out of
# the repo so `npx skills add laughing-hermit/librocat` finds only librocat's own.
.claude/skills/

# A maintainer's own notes for Claude Code (loaded with CLAUDE.md, never committed)
CLAUDE.local.md
