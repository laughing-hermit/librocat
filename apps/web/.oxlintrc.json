{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": { "correctness": "off" },
  "plugins": [],
  "jsPlugins": ["@shadcn/lint"],
  "rules": {
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"],
        "contracts": [
          {
            "pattern": "^(CardContent|AccordionContent|TableCell)$",
            "allow": ["layout", "spacing", "typography", "color"]
          },
          { "pattern": "^CardHeader$", "allow": ["layout", "spacing"] },
          { "pattern": "^AccordionTrigger$", "allow": ["layout", "typography"] },
          { "pattern": "^(TableRow|SidebarMenuButton)$", "allow": ["layout", "color"] },
          { "pattern": "^(Avatar|AvatarFallback|Skeleton)$", "allow": ["layout", "shape"] },
          { "pattern": "^Input$", "allow": ["layout", "pl-9"] },
          { "pattern": "^(InputGroupInput|InputGroupText)$", "allow": ["layout", "typography"] }
        ]
      }
    ],
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": ["error", { "allow": ["grid-cols-*"] }],
    "shadcn/no-inline-styles": "error",
    "shadcn/no-unknown-classes": ["error", { "allow": ["toaster", "cn-input-otp"] }],
    "shadcn/require-static-classes": "error"
  },
  "overrides": [
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/no-inline-styles": "off",
        "shadcn/require-static-classes": "off"
      }
    },
    {
      "files": ["src/app/opengraph-image.tsx"],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-raw-colors": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/no-inline-styles": "off",
        "shadcn/no-unknown-classes": "off",
        "shadcn/require-static-classes": "off"
      }
    }
  ],
  "ignorePatterns": ["convex/**", "tests/**", "scripts/**", ".next/**"]
}
