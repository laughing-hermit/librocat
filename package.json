{
  "name": "librocat-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "e2e": "bash apps/web/scripts/e2e.sh",
    "typecheck": "turbo run typecheck",
    "lint": "biome check . && pnpm --filter web run lint:design",
    "format": "biome format --write .",
    "plugin": "node scripts/check-plugin.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^24.19.1",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
